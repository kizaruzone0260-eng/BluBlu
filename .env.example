# Copy to .env and fill in. NEVER commit .env.
# --- Domain (required for HTTPS + TURN/TLS) ---
# Free option: DuckDNS subdomain; more reliable: own cheap domain.
DOMAIN=klass.example.com

# --- Proxy ---
# Set to 1 only when the API is reached THROUGH a reverse proxy that sets
# X-Forwarded-For (Caddy in production, cloudflared in demo, Render in cloud).
# 0 (default): client IP is taken from the socket — the header is NOT trusted.
TRUST_PROXY=0

# --- Postgres ---
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://klass:change-me-strong@postgres:5432/klass

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=change-me-min-32-chars-please-aaaaaaaaaaaaaaaa
# argon2id parameters (defaults are fine; production raises lower values to at least 19456/2/1)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- LiveKit ---
# Create a key pair at https://docs.livekit.io/home/get-started/authentication/
# (or `livekit-server generate-keys`); both are free/local.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret123456
LIVEKIT_WS_URL=wss://klass.example.com/rtc
# Optional: self-hosted LiveKit address for server-side API (RoomService) calls.
# Default: http://localhost:7880 (compose network uses the service name).
LIVEKIT_INTERNAL_URL=http://localhost:7880

# --- Demo mode (docs/DEMO.md) — leave empty for production ---
# External LiveKit address (e.g. LiveKit Cloud wss://xxxx.livekit.cloud).
# When set, it overrides LIVEKIT_WS_URL for clients and LIVEKIT_INTERNAL_URL for
# server-side RoomService calls. The demo scripts do not need it manually:
# scripts/demo.mjs gets the address from this variable.
LIVEKIT_URL=
# Public origin of this instance (https://xxxx.trycloudflare.com).
# Used for notification links and CORS/CSRF checks. scripts/demo.mjs fills it
# automatically from the Cloudflare Tunnel output — it may stay empty here.
PUBLIC_URL=

# --- Telegram bot (stage 6) ---
TELEGRAM_BOT_TOKEN=
# live bot: @classblu_bot — the Mini App shows this name to an unlinked user
TELEGRAM_BOT_NAME=classblu_bot
TELEGRAM_WEBHOOK_SECRET=
# log = writes messages to stdout (dev/tests); telegram = real Bot API
TELEGRAM_TRANSPORT=log
# webhook = production (needs DOMAIN + Telegram reaching your server);
# polling = demo (long-polling from your laptop, no inbound ports needed)
TELEGRAM_MODE=webhook

# --- Telegram homework assistant: AI formatting ---
# none = safe local assembly without reformulation (preview says AI is off).
# openai-compatible = POST {AI_BASE_URL}/chat/completions with a bearer key.
# Any OpenAI-compatible endpoint works; the key stays on the server and is never logged.
# The model only ever sees the teacher's own text and the titles of chosen materials:
# there is no vision/OCR setting because file contents are never sent anywhere.
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# One HTTP call ceiling; a stuck provider must not hold the bot update forever.
AI_TIMEOUT_MS=30000

# --- Storage ---
STORAGE_DIR=/data/files
MAX_FILE_MB=100
TEACHER_QUOTA_GB=5

# --- Instance owner teacher (seed) ---
SEED_TEACHER_EMAIL=owner@example.com
SEED_TEACHER_NAME=Owner
SEED_TEACHER_PASSWORD=change-me-first-login

# --- Caddy ---
CADDY_EMAIL=admin@example.com

# --- Data retention (часть 4) ---
# Сколько дней хранить архив завершённых уроков (доски, комментарии, запись присутствия).
# 0 (по умолчанию) = НЕ удалять никогда: фоновый уборщик даже не обращается к базе.
# Положительное значение: раз в 10 минут удаляются уроки, завершённые раньше этого срока;
# идущий урок удалению не подлежит, а вложения (доски, комментарии, руки, присутствие) уходят
# каскадом. Архив — учебная история, поэтому включается только решением владельца.
BOARD_ARCHIVE_RETENTION_DAYS=0

# --- Email (часть F: подтверждение почты при регистрации) ---
# none (по умолчанию) = письма нет, регистрация не требует кода — поведение прежнее байт-в-байт.
# console = письмо не уходит, а код печатается одной строкой в stdout (адрес маскируется):
#             режим разработки и тестов, где живого почтового ящика нет.
# brevo / resend = HTTP-API провайдера (ключ + EMAIL_FROM обязательны, иначе старт отказывается).
# smtp = свой минимальный клиент (EHLO/STARTTLS/AUTH LOGIN/MAIL FROM/RCPT TO/DATA), без новой
#        зависимости в dependencies; требует SMTP_HOST, пара SMTP_USER+SMTP_PASS — вместе или нет.
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=BluBlu
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=10000
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_HELO_NAME=blublu.local
