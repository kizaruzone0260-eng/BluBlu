{
  "name": "@klass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "reset-teacher": "node scripts/reset-teacher.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:secure": "node scripts/secure-db.mjs",
    "seed:teacher": "tsx --env-file=../../.env src/scripts/seed-teacher.ts",
    "demo": "node scripts/demo.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "node scripts/with-postgres.mjs pnpm exec vitest run",
    "db:audit": "node scripts/rls-audit.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.1",
    "@klass/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "grammy": "^1.46.0",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.7.3",
    "pg-boss": "^12.36.0",
    "postgres": "^3.4.5",
    "rrule": "^2.8.1",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
