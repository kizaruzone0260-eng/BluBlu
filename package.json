{
  "name": "klass",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted online lesson platform (working title: Klass)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @klass/api dev",
    "dev:web": "pnpm --filter @klass/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @klass/api db:generate",
    "db:migrate": "pnpm --filter @klass/api db:migrate",
    "seed:teacher": "pnpm --filter @klass/api seed:teacher",
    "demo": "node apps/api/scripts/demo.mjs",
    "demo:check": "node apps/api/scripts/demo-check.mjs",
    "audit": "pnpm audit --prod",
    "audit:gate": "node scripts/audit-gate.mjs",
    "cloud:smoke": "node apps/api/scripts/cloud-smoke.mjs",
    "bot:status": "node apps/api/scripts/bot-status.mjs",
    "db:audit": "pnpm --filter @klass/api db:audit"
  },
  "pnpm": {
    "overrides": {
      "lodash-es@^4": "^4.18.1",
      "nanoid@^3": "3.3.19",
      "nanoid@^4": "^5.1.16",
      "esbuild": "^0.28.2",
      "dompurify@^3": "3.4.17",
      "fast-uri@^3": "3.1.9",
      "fast-uri@^4": "4.2.3"
    }
  }
}
