{
  "name": "@klass/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./boardDocxBuild": {
      "types": "./dist/boardDocxBuild.d.ts",
      "default": "./dist/boardDocxBuild.js"
